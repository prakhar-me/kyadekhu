{
  "rewrites": [
    { "source": "/api/tmdb/:path*", "destination": "/api/tmdb?__path=:path*" },
    { "source": "/api/ads/:path*", "destination": "/api/ads?__path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/ads/tick", "schedule": "35 14 * * *" }]
}
