# TMDB credentials — server-side only. Never prefix these with VITE_,
# or Vite will bundle them into client JavaScript.
# Get them at https://www.themoviedb.org/settings/api
#
# Set ONE of the two. The read access token (v4) is preferred.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Advertiser enquiry form — option A (easiest): Web3Forms.
# Get a free key by entering your email at https://web3forms.com (no account).
# The key is public by design, so it is a VITE_ variable (it ends up in the
# browser bundle). On Vercel, add it and redeploy: VITE_ vars are build-time.
VITE_WEB3FORMS_ACCESS_KEY=

# Option B: Resend, via our server endpoint POST /api/enquiry (server-side only).
# Used when VITE_WEB3FORMS_ACCESS_KEY is empty.
# Enquiries are emailed via Resend (free tier: https://resend.com/api-keys).
# Without a verified domain, Resend only delivers to your own account email,
# so set ENQUIRY_TO_EMAIL to the address you signed up with.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Optional, once you verify a domain in Resend:
# ENQUIRY_FROM_EMAIL=Kya Dekhu <ads@yourdomain.com>
