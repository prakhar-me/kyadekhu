# TMDB credentials — server-side only. Never prefix these with VITE_,
# or Vite will bundle them into client JavaScript.
# Get them at https://www.themoviedb.org/settings/api
#
# Set ONE of the two. The read access token (v4) is preferred.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Weekly homepage ad auction (/advertise, /admin).
# Set to true to open bidding; otherwise /advertise shows the enquiry form below.
# Read at build time, so redeploy after changing it on Vercel.
VITE_ADS_LIVE=false

# The rest are server-side only.

# Postgres. On Vercel: Storage -> Create -> Neon (free); it sets this for you.
# Leave empty locally to use an embedded database in ./data.
DATABASE_URL=

# Password for /admin.
ADMIN_PASSWORD=
# Where auction results and payment notices go.
ADMIN_EMAIL=

# Outgoing email (bid confirmations, outbid notices, payment links).
# Gmail works: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Leave empty locally to write emails to data/outbox.log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM=Kya Dekhu <you@gmail.com>

# Razorpay (use test keys for now): https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public site URL, used in links inside emails sent by the daily cron.
SITE_URL=https://kyadekhu.vercel.app

# Advertiser enquiry form — option A (easiest): Web3Forms.
# Get a free key by entering your email at https://web3forms.com (no account).
# The key is public by design, so it is a VITE_ variable (it ends up in the
# browser bundle). On Vercel, add it and redeploy: VITE_ vars are build-time.
VITE_WEB3FORMS_ACCESS_KEY=

# Option B: Resend, via our server endpoint POST /api/enquiry (server-side only).
# Used when VITE_WEB3FORMS_ACCESS_KEY is empty.
# Enquiries are emailed via Resend (free tier: https://resend.com/api-keys).
# Without a verified domain, Resend only delivers to your own account email,
# so set ENQUIRY_TO_EMAIL to the address you signed up with.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Optional, once you verify a domain in Resend:
# ENQUIRY_FROM_EMAIL=Kya Dekhu <ads@yourdomain.com>
