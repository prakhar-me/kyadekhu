# TMDB credentials — server-side only. Never prefix these with VITE_,
# or Vite will bundle them into client JavaScript.
# Get them at https://www.themoviedb.org/settings/api
#
# Set ONE of the two. The read access token (v4) is preferred.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Weekly homepage ad auction (/advertise, /admin). All server-side only.

# Postgres. On Vercel: Storage -> Create -> Neon (free); it sets this for you.
# Leave empty locally to use an embedded database in ./data.
DATABASE_URL=

# Password for /admin.
ADMIN_PASSWORD=
# Where auction results and payment notices go.
ADMIN_EMAIL=

# Outgoing email (bid confirmations, outbid notices, payment links).
# Gmail works: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Leave empty locally to write emails to data/outbox.log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM=Kya Dekhu <you@gmail.com>

# Razorpay (use test keys for now): https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public site URL, used in links inside emails sent by the daily cron.
SITE_URL=https://kyadekhu.vercel.app
